{
    "swagger": "2.0",
    "info": {
        "description": "This is the Salesdesk API",
        "title": "Salesdesk API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/v1/bot": {
            "get": {
                "description": "Returns bot info for the given Instance (AccountID)",
                "tags": [
                    "Bot"
                ],
                "operationId": "getBotByInstance",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Instance (AccountID)",
                        "name": "instance",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/bot.BotDTO"
                        }
                    },
                    "404": {
                        "description": "No Bot Found for given Instance",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Add new bot to salesdesk",
                "tags": [
                    "Bot"
                ],
                "operationId": "addNewBot",
                "parameters": [
                    {
                        "description": "New bot values",
                        "name": "InsertBotRequest",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/bot.InsertBotDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Missing or Invalid body Inputs",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/v1/bot/all": {
            "get": {
                "description": "Returns all bots info",
                "tags": [
                    "Bot"
                ],
                "operationId": "getAllBots",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/bot.BotDAO"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/v1/bot/{botId}": {
            "get": {
                "description": "Returns bot info for the given BotID",
                "tags": [
                    "Bot"
                ],
                "operationId": "getBotById",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bot ID",
                        "name": "botId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/bot.BotDTO"
                        }
                    },
                    "404": {
                        "description": "No Bot Found for given BotID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "Removes bot from integrations webhook",
                "tags": [
                    "Bot"
                ],
                "operationId": "deleteBotById",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bot ID",
                        "name": "botId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Bot not found for given BotID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/v1/bot/{botId}/webhook": {
            "post": {
                "description": "Update Bot Webhook data",
                "tags": [
                    "Bot"
                ],
                "operationId": "updateBotWebhook",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bot ID",
                        "name": "botId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "New webhook data values",
                        "name": "UpdateBotWebhookRequest",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/bot.WebhookMetadata"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/bot.UpdateBotWebhookResponse"
                        }
                    },
                    "400": {
                        "description": "Missing or Invalid path/body Inputs",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Missing authorization token in header",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/v1/sync": {
            "get": {
                "description": "Sync the Salesdesk template data with the data from engagement. It will get all botIds in our DB and update out of sync templates in Engagement for that given BotIds",
                "tags": [
                    "Template"
                ],
                "operationId": "syncTemplates",
                "responses": {
                    "200": {
                        "description": "Synchronization completed successfully",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/v1/template": {
            "get": {
                "description": "Returns a list of templates for a given account and departments that matches a search string",
                "tags": [
                    "Template"
                ],
                "operationId": "getTemplates",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Account ID",
                        "name": "accountId",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Departments IDs, separated by comma",
                        "name": "departmentsIds",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Search term",
                        "name": "search",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Boolean value: whether the templates to be searched are active or not. Deafult false",
                        "name": "isActiveSalesdesk",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/template.TemplatePaginatedDTO"
                        }
                    },
                    "400": {
                        "description": "Missing AccountId input",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/v1/template/{id}": {
            "get": {
                "description": "Get template by ID",
                "tags": [
                    "Template"
                ],
                "operationId": "getTemplate",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The template ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "description": "Boolean value: If 'true' it will return additional information from engagement about this template",
                        "name": "full",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Returned Template",
                        "schema": {}
                    },
                    "400": {
                        "description": "Unable to get template for given id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found template for given id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "description": "Update template custom fields",
                "tags": [
                    "Template"
                ],
                "operationId": "updateTemplate",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The template ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Update Template body params",
                        "name": "TemplateUpdateRequest",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.TemplateData"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Template updated successfully",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/v2/bot": {
            "get": {
                "description": "Returns all bots info for the given Instance (AccountID)",
                "tags": [
                    "Bot"
                ],
                "operationId": "getBotsByInstance",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Instance (AccountID)",
                        "name": "instance",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/bot.BotDAO"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "bot.BotDAO": {
            "type": "object",
            "properties": {
                "botID": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "customerId": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "integrationsKey": {
                    "type": "string"
                },
                "returnChatToBot": {
                    "type": "boolean"
                },
                "salesdeskAccountID": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                },
                "webhookMetadata": {
                    "$ref": "#/definitions/bot.WebhookMetadata"
                },
                "workflowEndpoint": {
                    "type": "string"
                }
            }
        },
        "bot.BotDTO": {
            "type": "object",
            "properties": {
                "botID": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "customerId": {
                    "type": "string"
                },
                "customerName": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "integrationsKey": {
                    "type": "string"
                },
                "returnChatToBot": {
                    "type": "boolean"
                },
                "salesdeskAccountID": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                },
                "webhookMetadata": {
                    "$ref": "#/definitions/bot.WebhookMetadata"
                },
                "workflowEndpoint": {
                    "type": "string"
                }
            }
        },
        "bot.InsertBotDTO": {
            "type": "object",
            "required": [
                "botId",
                "salesdeskAccountId"
            ],
            "properties": {
                "botId": {
                    "type": "string"
                },
                "returnChatToBot": {
                    "type": "boolean"
                },
                "salesdeskAccountId": {
                    "type": "string"
                },
                "webhookMetadata": {
                    "$ref": "#/definitions/bot.WebhookMetadata"
                },
                "workflowEndpoint": {
                    "type": "string"
                }
            }
        },
        "bot.UpdateBotWebhookResponse": {
            "type": "object",
            "properties": {
                "webhook": {
                    "type": "string"
                }
            }
        },
        "bot.WebhookMetadata": {
            "type": "object",
            "properties": {
                "chatBacklogInHours": {
                    "type": "integer"
                },
                "messagesPerRequest": {
                    "type": "integer"
                },
                "phone": {
                    "type": "string"
                },
                "webhook": {
                    "type": "string"
                }
            }
        },
        "models.NamedError": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                }
            }
        },
        "models.TemplateData": {
            "type": "object",
            "properties": {
                "isActiveSalesdesk": {
                    "type": "boolean"
                },
                "sharedWith": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "template.SyncTemplatesErrorResponse": {
            "type": "object",
            "properties": {
                "errors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.NamedError"
                    }
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "template.TemplateDAO": {
            "type": "object",
            "properties": {
                "bodyText": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "isActive": {
                    "type": "boolean"
                },
                "isActiveSalesdesk": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "sharedWith": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "status": {
                    "type": "string"
                },
                "subscriptionID": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "template.TemplatePaginatedDTO": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer"
                },
                "offset": {
                    "type": "integer"
                },
                "templates": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/template.TemplateDAO"
                    }
                },
                "total": {
                    "type": "integer"
                }
            }
        }
    }
}